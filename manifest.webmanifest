{
  "name": "Smokies Live",
  "short_name": "Smokies Live",
  "description": "Live 3D map and community feed for the Great Smoky Mountains: weather, roads, cameras, news, events and reports from neighbors.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e1612",
  "theme_color": "#0e1612",
  "categories": ["navigation", "social", "weather", "news"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Report something", "url": "./#report", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Feed", "url": "./#feed", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
